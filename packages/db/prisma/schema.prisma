generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum TriggerType {
  MANUAL
}

enum JobLogStream {
  STDOUT
  STDERR
}

enum RunnerStatus {
  ONLINE
  OFFLINE
  BUSY
  DRAINING
}


model User {
  id             String   @id @default(uuid()) @db.Uuid
  githubUserId   String   @unique
  githubUsername String
  avatarUrl      String?
  email          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions     Session[]
  repositories Repository[]

  @@index([githubUsername])
  @@index([githubUserId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// REPOSITORY
// ─────────────────────────────────────────────

model Repository {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid

  name          String
  owner         String
  url           String @unique
  defaultBranch String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflows Workflow[]

  @@index([owner])
  @@index([userId])
}

// ─────────────────────────────────────────────
// WORKFLOW
// ─────────────────────────────────────────────

model Workflow {
  id String @id @default(uuid()) @db.Uuid

  repositoryId String @db.Uuid

  name          String
  configVersion Int    @default(1)

  // Workflow definition.
  //
  // Example:
  //
  // {
  //   "jobs": [
  //     {
  //       "name": "build",
  //       "commands": [
  //         "npm install",
  //         "npm test",
  //         "npm run build"
  //       ]
  //     }
  //   ]
  // }
  definition Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  runs WorkflowRun[]

  @@index([repositoryId])
}

// ─────────────────────────────────────────────
// WORKFLOW RUN
// ─────────────────────────────────────────────

model WorkflowRun {
  id         String @id @default(uuid()) @db.Uuid
  workflowId String @db.Uuid

  branch    String
  commitSha String?

  status      WorkflowRunStatus @default(QUEUED)
  triggerType TriggerType       @default(MANUAL)

  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  jobs     Job[]

  @@index([workflowId])
  @@index([status])
  @@index([queuedAt])
  @@index([commitSha])
}

// ─────────────────────────────────────────────
// JOB
// ─────────────────────────────────────────────

model Job {
  id String @id @default(uuid()) @db.Uuid

  workflowRunId String @db.Uuid

  name String

  // Commands that this job will execute.
  //
  // Example:
  //
  // [
  //   "npm install",
  //   "npm test"
  // ]
  commands Json

  status JobStatus @default(QUEUED)

  runnerId String? @db.Uuid

  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  exitCode     Int?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  runner      Runner?     @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  logs        JobLog[]

  @@index([workflowRunId])
  @@index([runnerId])
  @@index([status])
  @@index([queuedAt])
}

// ─────────────────────────────────────────────
// JOB LOG
// ─────────────────────────────────────────────

model JobLog {
  id String @id @default(uuid()) @db.Uuid

  jobId String @db.Uuid

  sequence Int
  stream   JobLogStream
  message  String

  createdAt DateTime @default(now())

  // Relations
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sequence])
  @@index([jobId])
}

// ─────────────────────────────────────────────
// RUNNER
// ─────────────────────────────────────────────

model Runner {
  id String @id @default(uuid()) @db.Uuid

  name String @unique

  status RunnerStatus @default(OFFLINE)

  capacity   Int @default(1)
  activeJobs Int @default(0)

  lastHeartbeat DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobs Job[]

  @@index([status])
  @@index([lastHeartbeat])
}
