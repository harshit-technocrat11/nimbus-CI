{
  "name": "nimbus_CI",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "postinstall": "pnpm --filter @nimbus-ci/db db:generate",
    "db:generate": "pnpm --filter @nimbus-ci/db db:generate",
    "db:migrate": "pnpm --filter @nimbus-ci/db db:migrate",
    "db:push": "pnpm --filter @nimbus-ci/db db:push",
    "db:studio": "pnpm --filter @nimbus-ci/db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=18"
  }
}

